# Copy to .env and fill in what you have. Everything is optional:
# with nothing set the app runs on the rules agent with clearly marked demo payments.
# Never commit .env.

# --- AI (free) -----------------------------------------------------------------
# Groq free tier, open-weight models, no card needed: https://console.groq.com/keys
AI_PROVIDER=groq
AI_API_KEY=
# Optional overrides (defaults shown). Check https://console.groq.com/docs/models for current ids.
# AI_MODEL=openai/gpt-oss-120b
# AI_VISION_MODEL=qwen/qwen3.8-27b
#
# Fully local and open source instead: install Ollama, `ollama pull qwen2.5:7b` and `ollama pull llama3.2-vision`, then:
# AI_PROVIDER=ollama
# AI_MODEL=qwen2.5:7b
# AI_VISION_MODEL=llama3.2-vision
#
# Any other OpenAI-compatible endpoint (e.g. OpenRouter free models):
# AI_PROVIDER=openrouter
# AI_BASE_URL=https://openrouter.ai/api/v1

# --- PayPal Sandbox (free): https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The platform's Sandbox business account merchant ID (Sandbox accounts > business > Account info).
PAYPAL_MERCHANT_ID=
# A second Sandbox account's email that receives supplier payouts (Payouts API).
SUPPLIER_PAYOUT_EMAIL=
# Optional: webhook ID from your Sandbox app after adding https://<your-host>/api/paypal/webhook
PAYPAL_WEBHOOK_ID=

# --- Platform --------------------------------------------------------------------
# Platform fee in basis points (500 = 5%), taken from the supplier payout.
PLATFORM_FEE_BPS=500
# Signs the demo persona cookie. Any long random string.
SESSION_SECRET=
# Postgres for persistence (e.g. free Neon). Leave empty to use data/runtime.json.
DATABASE_URL=
PORT=4173
